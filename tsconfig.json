{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "target": "ES2015",
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "preserve",
        "declaration": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}