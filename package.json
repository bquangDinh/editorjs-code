  },
  "homepage": "https://github.com/bquangDinh/editorjs-code#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
